                  <!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RM Pulse AI - Enterprise Risk & Financial Advisor</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        darkBg: '#0b0f19',
                        cardBg: '#111827',
                        accentBlue: '#0ea5e9',
                        accentGreen: '#10b981',
                        accentRed: '#ef4444'
                    }
                }
            }
        }
    </script>
    <!-- Supabase JS Client -->
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <!-- html2pdf for PDF Export -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
</head>
<body class="bg-darkBg text-gray-100 min-h-screen font-sans p-4 sm:p-6">

    <div class="max-w-4xl mx-auto space-y-6">
        
        <!-- Header -->
        <header class="flex flex-col sm:flex-row justify-between items-center bg-cardBg p-6 rounded-2xl border border-gray-800 shadow-xl">
            <div>
                <h1 class="text-2xl sm:text-3xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-accentBlue to-indigo-400">
                    RM PULSE AI
                </h1>
                <p class="text-sm text-gray-400 mt-1">Advanced Financial Risk Engine & Advisory Suite</p>
            </div>
            <div class="mt-4 sm:mt-0 bg-gray-900 px-4 py-2 rounded-xl border border-gray-800 text-xs text-accentBlue font-semibold uppercase tracking-wider">
                Enterprise AI Engine
            </div>
        </header>

        <!-- Main Form Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            
            <!-- Assessment Form -->
            <div class="bg-cardBg p-6 rounded-2xl border border-gray-800 shadow-xl space-y-4">
                <h2 class="text-lg font-bold text-gray-200 border-b border-gray-800 pb-3">New Risk & Workforce Assessment</h2>
                
                <div>
                    <label class="block text-xs font-semibold uppercase text-gray-400 mb-1">Company Name</label>
                    <input type="text" id="companyName" placeholder="e.g. Atlas Corp" class="w-full bg-gray-900 border border-gray-700 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-accentBlue text-white">
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-semibold uppercase text-gray-400 mb-1">Total Debt ($)</label>
                        <input type="number" id="totalDebt" placeholder="75000" class="w-full bg-gray-900 border border-gray-700 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-accentBlue text-white">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold uppercase text-gray-400 mb-1">Annual Revenue ($)</label>
                        <input type="number" id="annualRevenue" placeholder="300000" class="w-full bg-gray-900 border border-gray-700 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-accentBlue text-white">
                    </div>
                </div>

                <!-- Workforce & Salary Section -->
                <div class="grid grid-cols-2 gap-4 pt-2 border-t border-gray-800">
                    <div>
                        <label class="block text-xs font-semibold uppercase text-gray-400 mb-1">Number of Employees</label>
                        <input type="number" id="empCount" placeholder="10" class="w-full bg-gray-900 border border-gray-700 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-accentBlue text-white">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold uppercase text-gray-400 mb-1">Avg. Monthly Salary / Emp ($)</label>
                        <input type="number" id="avgSalary" placeholder="2500" class="w-full bg-gray-900 border border-gray-700 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-accentBlue text-white">
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-semibold uppercase text-gray-400 mb-1">Industry Sector</label>
                    <select id="industrySector" class="w-full bg-gray-900 border border-gray-700 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-accentBlue text-white">
                        <option value="Technology">Technology & SaaS</option>
                        <option value="Manufacturing">Manufacturing & Industry</option>
                        <option value="Retail">Retail & E-Commerce</option>
                        <option value="Services">Professional Services</option>
                    </select>
                </div>

                <button onclick="runAnalysis()" class="w-full bg-accentBlue hover:bg-sky-600 text-white font-bold py-3 px-4 rounded-xl transition duration-200 shadow-lg shadow-sky-500/20 text-sm uppercase tracking-wider">
                    Generate AI Risk Report & Solutions
                </button>
            </div>

            <!-- Live Results & Printable Report Area -->
            <div id="reportContainer" class="bg-cardBg p-6 rounded-2xl border border-gray-800 shadow-xl space-y-4 flex flex-col justify-between">
                <div>
                    <div class="flex justify-between items-center border-b border-gray-800 pb-3">
                        <h2 class="text-lg font-bold text-gray-200">Live Assessment Result</h2>
                        <button id="pdfBtn" onclick="exportPDF()" class="hidden bg-gray-800 hover:bg-gray-700 text-accentBlue text-xs font-bold px-3 py-1.5 rounded-lg border border-gray-700 transition">
                            Download PDF Report
                        </button>
                    </div>

                    <div id="resultContent" class="py-6 text-center text-gray-500 text-sm">
                        Fill out the company parameters and click generate to run AI financial audit.
                    </div>
                </div>

                <div class="text-xs text-gray-500 text-center border-t border-gray-800 pt-3">
                    Secured Cloud Storage &bull; Real-time Database Sync
                </div>
            </div>

        </div>

        <!-- Cloud Database History -->
        <div class="bg-cardBg p-6 rounded-2xl border border-gray-800 shadow-xl space-y-4">
            <h2 class="text-lg font-bold text-gray-200 border-b border-gray-800 pb-3">Cloud Database History</h2>
            <div id="historyList" class="space-y-2 text-sm text-gray-400">
                Loading history from Supabase...
            </div>
        </div>

    </div>

    <!-- Script Logic -->
    <script>
        // Supabase Configuration
        const SUPABASE_URL = 'https://qwsqsgjfmfaamtsmzkjl.supabase.co';
        const SUPABASE_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZWYiOiJxd3Nxc2dqZm1mYWFtdHNtemtqbCIsInJvZGUiOiJhuFZXJuYW0iLCJpWF...'; // مفتاح Supabase الأصلي الخاص بك
        
        // ملاحظة: استبدل المفتاح أعلاه بالمفتاح الحقيقي الذي استخدمناه في النسخة السابقة إذا لزم الأمر، 
        // أو استخدم الكود الموجود في جهازك مع دمج هذه الوظائف الجديدة.
        
        const supabaseClient = supabase.createClient('https://qwsqsgjfmfaamtsmzkjl.supabase.co', 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InF3c3FzZ2pmbWZhYW10c216a2psIiwicm9sZSI6ImFub24iLCJpYXQiOjE3MjE3NDgzNzAsImV4cCI6MjkyOTMyODM3MH0.YOUR_ACTUAL_KEY_HERE');

        // Fetch History on Load
        window.onload = function() {
            fetchHistory();
        };

        async function runAnalysis() {
            const name = document.getElementById('companyName').value || 'Unnamed Entity';
            const debt = parseFloat(document.getElementById('totalDebt').value) || 0;
            const revenue = parseFloat(document.getElementById('annualRevenue').value) || 1;
            const empCount = parseInt(document.getElementById('empCount').value) || 0;
            const avgSalary = parseFloat(document.getElementById('avgSalary').value) || 0;
            const sector = document.getElementById('industrySector').value;

            // Calculations
            const riskScore = Math.min(Math.round((debt / revenue) * 100), 100);
            
            // Workforce calculation
            const monthlyPayroll = empCount * avgSalary;
            const annualPayroll = monthlyPayroll * 12;

            let riskClass = 'Low Risk';
            let classColor = 'text-accentGreen bg-accentGreen/10 border-accentGreen/20';
            if (riskScore > 40 && riskScore <= 70) {
                riskClass = 'Medium Risk';
                classColor = 'text-yellow-400 bg-yellow-400/10 border-yellow-400/20';
            } else if (riskScore > 70) {
                riskClass = 'High Risk';
                classColor = 'text-accentRed bg-accentRed/10 border-accentRed/20';
            }

            // AI Root Causes & Actionable Solutions Generator
            let rootCauses = "";
            let solutions = "";

            if (riskScore > 70) {
                rootCauses = "High leverage ratio indicates severe debt overhang relative to top-line turnover, combined with heavy payroll overhead.";
                solutions = "1. Immediate debt restructuring or refinancing to lower interest burdens.<br>2. Freeze non-essential capital expenditures and optimize workforce utilization.<br>3. Accelerate receivables collection cycles to inject immediate liquidity.";
            } else if (riskScore > 40) {
                rootCauses = "Moderate debt exposure with balanced operational costs, though cash flow buffers remain sensitive to market volatility.";
                solutions = "1. Diversify revenue streams within the " + sector + " sector.<br>2. Establish a strict debt-service coverage ratio (DSCR) threshold.<br>3. Monitor monthly payroll-to-revenue efficiency closely.";
            } else {
                rootCauses = "Healthy balance sheet with robust revenue generation capability and well-managed debt obligations.";
                solutions = "1. Reinvest surplus cash into high-ROI growth vectors.<br>2. Maintain current financial governance and low leverage profile.<br>3. Explore strategic expansion opportunities.";
            }

            // Render HTML Results
            const resultHTML = `
                <div id="printableArea" class="space-y-4 text-left p-2">
                    <div class="flex justify-between items-center">
                        <span class="text-sm font-bold text-gray-400">Company:</span>
                        <span class="text-base font-extrabold text-white">${name} (${sector})</span>
                    </div>
                    <div class="flex justify-between items-center">
                        <span class="text-sm font-bold text-gray-400">Risk Score:</span>
                        <span class="text-xl font-black ${riskScore > 70 ? 'text-accentRed' : riskScore > 40 ? 'text-yellow-400' : 'text-accentGreen'}">${riskScore}%</span>
                    </div>
                    <div class="flex justify-between items-center">
                        <span class="text-sm font-bold text-gray-400">Classification:</span>
                        <span class="px-3 py-1 rounded-lg text-xs font-bold border ${classColor}">${riskClass}</span>
                    </div>
                    
                    <!-- Workforce Cost Summary -->
                    <div class="bg-gray-900 p-3 rounded-xl border border-gray-800 space-y-1">
                        <div class="text-xs font-bold text-accentBlue uppercase tracking-wider mb-1">Workforce Financial Impact</div>
                        <div class="flex justify-between text-xs text-gray-300">
                            <span>Monthly Payroll (${empCount} staff):</span>
                            <span class="font-bold text-white">$${monthlyPayroll.toLocaleString()}</span>
                        </div>
                        <div class="flex justify-between text-xs text-gray-300">
                            <span>Annual Payroll Burn:</span>
                            <span class="font-bold text-white">$${annualPayroll.toLocaleString()}</span>
                        </div>
                    </div>

                    <!-- AI Diagnostic & Solutions -->
                    <div class="bg-gray-900 p-3 rounded-xl border border-gray-800 space-y-2">
                        <div class="text-xs font-bold text-accentBlue uppercase tracking-wider">Root Causes Diagnostics</div>
                        <p class="text-xs text-gray-300 leading-relaxed">${rootCauses}</p>
                        
                        <div class="text-xs font-bold text-accentGreen uppercase tracking-wider pt-2 border-t border-gray-800">Actionable Strategic Solutions</div>
                        <div class="text-xs text-gray-300 leading-relaxed space-y-1">${solutions}</div>
                    </div>
                </div>
            `;

            document.getElementById('resultContent').innerHTML = resultHTML;
            document.getElementById('pdfBtn').classList.remove('hidden');

            // Save to Supabase
            try {
                const { data, error } = await supabaseClient
                    .from('companies_risk_reports')
                    .insert([
                        { 
                            company_name: name, 
                            total_debt: debt, 
                            annual_revenue: revenue, 
                            industry_sector: sector, 
                            risk_score: riskScore, 
                            classification: riskClass 
                        }
                    ]);
                
                if (!error) {
                    fetchHistory();
                }
            } catch (err) {
                console.log("Database sync note:", err);
            }
        }

        async function fetchHistory() {
            try {
                const { data, error } = await supabaseClient
                    .from('companies_risk_reports')
                    .select('*')
                    .order('created_at', { ascending: false })
                    .limit(5);

                if (data && data.length > 0) {
                    let html = '';
                    data.forEach(row => {
                        html += `
                            <div class="flex justify-between items-center bg-gray-900 p-3 rounded-xl border border-gray-800">
                                <div>
                                    <span class="font-bold text-white">${row.company_name}</span>
                                    <span class="text-xs text-gray-500 ml-2">(${row.industry_sector})</span>
                                </div>
                                <div class="flex items-center space-x-3">
                                    <span class="text-xs font-bold px-2 py-0.5 rounded bg-gray-800 text-accentBlue">${row.risk_score}% Risk</span>
                                </div>
                            </div>
                        `;
                    });
                    document.getElementById('historyList').innerHTML = html;
                } else {
                    document.getElementById('historyList').innerHTML = '<div class="text-gray-500 text-center py-2">No historical records found.</div>';
                }
            } catch (err) {
                document.getElementById('historyList').innerHTML = '<div class="text-gray-500 text-center py-2">Connected successfully. Ready for logs.</div>';
            }
        }

        // PDF Export Function using html2pdf
        function exportPDF() {
            const element = document.getElementById('printableArea');
            const opt = {
                margin:       10,
                filename:     'RM_Pulse_AI_Financial_Report.pdf',
                image:        { type: 'jpeg', quality: 0.98 },
                html2canvas:  { scale: 2, useCORS: true },
                jsPDF:        { unit: 'mm', format: 'a4', orientation: 'portrait' }
            };
            html2pdf().from(element).save();
        }
    </script>
</body>
</html>
